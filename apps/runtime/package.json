{
  "name": "@companion/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "companion-purge": "node dist/companionPurge.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "COMPANION_INTEGRATION_TESTS=1 vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.744.0",
    "@companion/box-runtime": "workspace:*",
    "@companion/companion-skill": "workspace:*",
    "@companion/companion-runtime": "workspace:*",
    "@companion/contracts": "workspace:*",
    "@companion/core": "workspace:*",
    "@companion/db": "workspace:*",
    "@companion/skills": "workspace:*",
    "@companion/storage": "workspace:*",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "3.2.7"
  }
}
