{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/Dockerfile.backend",
    "watchPatterns": [
      "/.dockerignore",
      "/apps/api/**",
      "/packages/**",
      "/deploy/railway/Dockerfile.backend",
      "/deploy/railway/release.railway.json",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json",
      "/turbo.json"
    ]
  },
  "deploy": {
    "startCommand": "node dist/migrate.js",
    "restartPolicyType": "NEVER"
  }
}
