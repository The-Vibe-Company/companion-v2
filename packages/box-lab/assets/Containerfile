FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS node24

FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash ca-certificates coreutils curl dbus-user-session findutils gzip jq login passwd procps \
    sudo systemd systemd-sysv tar util-linux xz-utils \
  && rm -rf /var/lib/apt/lists/* \
  && systemctl mask \
    console-getty.service \
    getty@.service \
    systemd-remount-fs.service \
  && groupmod --new-name user ubuntu \
  && usermod --login user --home /home/user --move-home --gid user ubuntu \
  && printf 'user ALL=(ALL) NOPASSWD:ALL\n' >/etc/sudoers.d/box-lab-user \
  && chmod 0440 /etc/sudoers.d/box-lab-user \
  && install -d -m 0755 /var/lib/systemd/linger \
  && touch /var/lib/systemd/linger/user

COPY --from=node24 /usr/local/ /usr/local/

RUN node --version | grep -Eq '^v24\.' \
  && npm --version >/dev/null \
  && install -d -o user -g user -m 0755 /home/user/.local \
  && runuser -u user -- npm config set prefix /home/user/.local --location=user \
  && chown -R user:user /home/user

ENV container=docker
ENV PATH=/home/user/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
