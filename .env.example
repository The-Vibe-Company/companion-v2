# Companion v2 local environment.

# --- API / web --------------------------------------------------------------
COMPANION_API_URL=http://127.0.0.1:3001
COMPANION_WEB_URL=http://127.0.0.1:3000
NEXT_PUBLIC_COMPANION_API_URL=http://127.0.0.1:3001
# Optional PostHog web analytics. Get these from the PostHog project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional Companions control plane. The same server-only flag gates the web shell
# and Box/Pi API routes. Restart both web and API after changing it. It defaults to false when unset,
# so production boots with Companions off and the Box/Pi/provider variables below stay optional.
# Only when this is true and the allowlist below is non-empty are COMPANION_BOX_API_KEY and
# COMPANION_SECRETS_MASTER_KEY required; the API still boots and logs a startup warning if they are
# missing while Companions is effectively enabled.
COMPANION_COMPANIONS_ENABLED=false
# Required when the master flag is true: comma-separated, case-insensitive email domains. Only
# authenticated users with an exact matching domain may see or use Companions. Unset/empty keeps
# Companions disabled and routes unregistered; missing or malformed user emails are denied.
COMPANION_COMPANIONS_ALLOWED_EMAIL_DOMAINS=
# Required only for live Companion lifecycle calls. Keep provider keys out of this file.
COMPANION_BOX_API_KEY=
COMPANION_BOX_API_BASE=https://ascii.dev/api/box/v1
COMPANION_BOX_ENVIRONMENT=
# Refreshed after every message Pi accepts, so idle expiry is six hours after the last message.
COMPANION_BOX_TTL_SECONDS=21600
# Optional Box provisioning timings. Unset falls back to these same in-code defaults.
COMPANION_BOX_POLL_INTERVAL_MS=1000
COMPANION_BOX_READY_TIMEOUT_MS=120000
# One-shot legacy purge polling; provider deletion remains fail-closed after this bounded wait.
COMPANION_BOX_DELETE_POLL_INTERVAL_MS=1000
COMPANION_BOX_DELETE_TIMEOUT_MS=900000
# How long one desktop join waits for Box to finish provisioning a VNC stream before it falls back to
# the WebRTC desktop. Every join mints a fresh URL, so this is a per-join wait, not a stream lifetime.
COMPANION_BOX_DESKTOP_MINT_BUDGET_MS=15000
# How long a restarted Pi daemon has to report `active` before a wake fails. `systemctl restart`
# returns as soon as systemd forks ExecStart, so a start polls the unit for this long.
COMPANION_PI_DAEMON_ACTIVE_TIMEOUT_MS=20000
# Prefer a Box template with pinned Pi. Otherwise set an operator-controlled pinned install command.
COMPANION_PI_INSTALL_COMMAND=
# Pin the Pi extension used for labeled MCP account injection.
COMPANION_PI_MCP_ADAPTER_PACKAGE=npm:pi-mcp-adapter@2.12.1
# GitHub's hosted MCP remote uses a deployment-owned GitHub OAuth App. Register this exact callback:
# ${COMPANION_WEB_URL}/v1/companion-plugins/oauth/callback
# Linear and Notion use MCP dynamic client registration and need no deployment-owned client keys.
COMPANION_MCP_GITHUB_CLIENT_ID=
COMPANION_MCP_GITHUB_CLIENT_SECRET=
# In production set BETTER_AUTH_URL to the API's public origin — the Google OAuth callback URL is
# derived from it (${BETTER_AUTH_URL}/auth/callback/google) and must be registered with Google.
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_COOKIE_PREFIX=better-auth
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-secret
# Required by Secrets in production, and reused to envelope-encrypt Companion provider subscription
# credentials when the Companions flag is true and its email-domain allowlist is non-empty. Generate with:
# node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
# Local launchers generate and persist a gitignored workspace key when this is empty.
COMPANION_SECRETS_MASTER_KEY=

# --- GitHub skill mirrors (optional GitHub App) -----------------------------
# Register one GitHub App with user-to-server OAuth enabled. Callback URL:
# ${COMPANION_WEB_URL}/v1/integrations/github/callback (the web origin proxies /v1 to the API)
# Permissions: Metadata read, Contents read/write, Administration read/write.
# In split production deployments, expose slug/client credentials only to the API and App ID/private
# key only to the worker. The combined local .env is inherited by both development processes.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM with literal \n characters or the PEM bytes encoded as base64.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_NAME=
# API-side acknowledgement that a separately configured worker can converge mirrors.
# Leave false to disable Workspace Settings > GitHub cleanly.
COMPANION_GITHUB_SYNC_ENABLED=false
# SaaS only: renders the official Companion App wording. Self-hosted stays false.
COMPANION_GITHUB_APP_MANAGED=false

# --- Skill databases --------------------------------------------------------
COMPANION_SKILL_DATABASES_ENABLED=false
# Bound hot-realm lock retries and queued SQLite WASM work.
COMPANION_SKILL_DB_LOCK_WAIT_MS=2500
COMPANION_SKILL_DB_STORAGE_TIMEOUT_MS=5000
COMPANION_SKILL_DB_DELETE_TIMEOUT_MS=5000
COMPANION_SKILL_DB_MAX_QUEUED_TASKS=8
COMPANION_SKILL_DB_MAX_QUEUED_BYTES=67108864
COMPANION_SKILL_DB_MAX_STARTUP_FAILURES=3
COMPANION_SKILL_DB_STARTUP_TIMEOUT_MS=10000
# --- Google OAuth (Better Auth social provider) -----------------------------
# Optional: the "Continue with Google" button always renders, but Google sign-in is only wired when
# both are set. Authorized redirect URI to register in Google Cloud: ${BETTER_AUTH_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Postgres ---------------------------------------------------------------
# API and worker URLs must use distinct NOSUPERUSER/NOBYPASSRLS/NOINHERIT roles that do not own
# tables. DATABASE_WORKER_URL is consumed by the local launcher; in production each service receives
# its own DATABASE_URL. Migrations use the separate owner URL; see packages/db/runtime-role-grants.sql.
DATABASE_URL=postgres://companion_api:companion-api@127.0.0.1:5432/companion
DATABASE_WORKER_URL=postgres://companion_worker:companion-worker@127.0.0.1:5432/companion
DATABASE_MIGRATION_URL=postgres://companion:companion@127.0.0.1:5432/companion
# Production API migration hook: apply separated table/function grants atomically after migrations.
DATABASE_API_ROLE=companion_api
DATABASE_WORKER_ROLE=companion_worker
# Migration-first rollout: leave unset until the dedicated LOGIN NOSUPERUSER/NOBYPASSRLS/NOINHERIT
# role exists. When configured it receives only the narrow Runtime v2 SECURITY DEFINER functions.
# DATABASE_COMPANION_RUNTIME_ROLE=companion_runtime_v2
# One cutover run only: after the split services are healthy, set this to the former union role so
# the migration hook revokes its current/default grants. Remove it after disabling or dropping that login.
# DATABASE_RETIRED_RUNTIME_ROLE=companion_runtime
# Legacy simple-install fallback: omit the two variables above and set one DATABASE_RUNTIME_ROLE.
# That role receives the API, worker, and v2 function capabilities, but never direct v2 table
# access. It is not suitable for production.
# DATABASE_RUNTIME_ROLE=companion_runtime
# Deployments upgrading from a release that still ran Projects and runs must settle their object
# storage and sandbox obligations once, with `node dist/cutover.js`, before migration 0063 can apply.
# It needs the migration URL above and the S3 credentials below. See deploy/railway/README.md.
COMPOSE_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- S3-compatible storage (MinIO locally) ---------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=companion
S3_SECRET_ACCESS_KEY=companion-secret
S3_BUCKET_SKILL_ARCHIVES=skill-archives
S3_FORCE_PATH_STYLE=true

# --- Email ------------------------------------------------------------------
# Verification + password-reset codes and org invites are sent through this provider. Use "mailpit"
# (read codes in the Mailpit UI) or "log" (console) locally; set "resend" + RESEND_API_KEY in production.
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Companion <noreply@companion.local>
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
RESEND_API_KEY=

# --- Billing (SaaS only; self-hosted defaults stay fully unlocked) ----------
COMPANION_BILLING_MODE=disabled
COMPANION_ENTITLEMENTS_MODE=off
COMPANION_ENTITLEMENT_PILOT_ORGS=
COMPANION_PRO_ORG_ALLOWLIST=
COMPANION_CHECKOUT_ENABLED=false
COMPANION_STRIPE_WEBHOOKS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
